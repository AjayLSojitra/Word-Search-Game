{
  "name": "word-search-game",
  "version": "11.0.0",
  "main": "index.js",
  "scripts": {
    "start": "TAMAGUI_TARGET=native expo start --clear --dev-client",
    "start:test": "TAMAGUI_TARGET=native APP_VARIANT=test expo start --clear --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "TAMAGUI_TARGET=web expo start --web --clear -p 19006",
    "web:test": "TAMAGUI_TARGET=web APP_VARIANT=test expo start --web --clear -p 19006",
    "build:web": "TAMAGUI_TARGET=web expo export --clear -p web",
    "build:web:test": "APP_VARIANT=test TAMAGUI_TARGET=web expo export --clear -p web",
    "build:web:beta": "APP_VARIANT=beta TAMAGUI_TARGET=web expo export --clear -p web",
    "build:web:production": "APP_VARIANT=production TAMAGUI_TARGET=web expo export --clear -p web",
    "serve:web": "npx serve dist -l 19006 --single",
    "dev-client-local:ios": "eas build --profile development-simulator --platform ios --local",
    "dev-client-local:android": "eas build --profile development --platform android --local",
    "eas-update:test": "TAMAGUI_TARGET=native APP_VARIANT=test eas update --branch=test",
    "eas-update:beta": "TAMAGUI_TARGET=native APP_VARIANT=beta eas update --branch=beta",
    "eas-update:production": "TAMAGUI_TARGET=native APP_VARIANT=production eas update --branch=production"
  },
  "dependencies": {
    "@babel/preset-env": "^7.24.0",
    "@expo-google-fonts/poppins": "^0.2.3",
    "@hookform/resolvers": "^3.3.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^21.14.0",
    "@react-native-firebase/app": "^21.14.0",
    "@react-native-firebase/auth": "^21.14.0",
    "@react-native-firebase/crashlytics": "^21.14.0",
    "@tamagui/animations-moti": "^1.126.1",
    "@tamagui/babel-plugin": "^1.126.1",
    "@tamagui/config": "^1.126.1",
    "@types/react": "~19.1.10",
    "babel-plugin-macros": "^3.1.0",
    "babel-preset-expo": "~54.0.10",
    "buffer": "^6.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "deepmerge": "^4.3.1",
    "expo": "^54.0.38",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.14",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-tracking-transparency": "~6.0.8",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "firebase": "^11.10.0",
    "lottie-react-native": "~7.3.1",
    "native-base": "^3.4.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.51.0",
    "react-modal": "^3.16.1",
    "react-native": "0.81.5",
    "react-native-device-info": "^10.13.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-google-mobile-ads": "^15.4.2",
    "react-native-in-app-review": "^4.3.3",
    "react-native-modal": "^13.0.1",
    "react-native-purchases": "^10.10.2",
    "react-native-purchases-ui": "^10.10.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-select-dropdown": "^4.0.1",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.2.0",
    "react-native-view-shot": "~4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "reflect-metadata": "~0.2.1",
    "tamagui": "^1.126.1",
    "typescript": "^5.4.2",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@types/react": "~19.1.10",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@callstack/react-theme-provider",
          "@babel/preset-env",
          "@tamagui/babel-plugin",
          "@tamagui/lucide-icons",
          "@tamagui/use-force-update",
          "class-transformer",
          "class-validator",
          "deepmerge",
          "firebase",
          "react-modal",
          "react-native-select-dropdown",
          "zustand",
          "reflect-metadata",
          "typescript",
          "native-base"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true
}
